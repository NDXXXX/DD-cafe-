DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 知识库管理接口的管理密钥（未配置时 CRUD/reindex 一律 403）
ADMIN_API_KEY=

POSTGRES_DB=dd_cafe
POSTGRES_USER=dd_cafe
POSTGRES_PASSWORD=dd_cafe_local
DATABASE_URL=postgresql+psycopg://dd_cafe:dd_cafe_local@localhost:5432/dd_cafe

REDIS_URL=redis://localhost:6379/0
REDIS_CHECKPOINTS=true
CHECKPOINT_TTL_MINUTES=120
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=dd_cafe_knowledge
RAG_DENSE_MODEL=BAAI/bge-small-zh-v1.5
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
RAG_RERANKER_ENABLED=true
RAG_RERANKER_PREWARM=true
WEB_SEARCH_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

VISION_API_KEY=
VISION_MODEL=qwen3-vl-flash
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
IMAGE_GEN_MODEL=qwen-image-max
IMAGE_GEN_SIZE=1328*1328
IMAGE_EDIT_MODEL=qwen-image-edit
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=data/uploads

VITE_API_BASE_URL=http://localhost:8000
